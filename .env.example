# Copy to `.env` (in this directory) to override the docker-compose defaults.
# docker compose reads `.env` automatically for variable substitution.

# --- Backend / Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
# Comma-separated list of hostnames the backend will accept.
ALLOWED_HOSTS=localhost,127.0.0.1
# Custom path for the Django admin panel.
ADMIN_PATH=admin

# --- PostgreSQL ---
DB_NAME=mole
DB_USER=moleuser
DB_PASSWORD=password

# --- Frontend (baked into the browser bundle at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000
