# Dependencies (reinstalled inside the image)
node_modules
.pnpm-store

# Build output (rebuilt inside the image)
.next
out

# Version control
.git
.gitignore

# Environment files (secrets / build-time vars must not be baked in)
.env
.env.*

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Docs / editor cruft
*.md
.editorconfig
